{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Watch Stylelint",
      "type": "npm",
      "script": "lint:style:watch",
      "isBackground": true,
      "problemMatcher": {
        "base": "$stylelint-compact",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "STYLELINT_START",
          "endsPattern": "STYLELINT_END"
        }
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
